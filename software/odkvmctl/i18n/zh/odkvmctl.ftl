cli-combo-entry = 组合键 { $n }：{ $keys } → { $output }
cli-override-entry = 按键替换 { $n }：{ $mods }+{ $trigger } → { $replacement }（{ $state }）
cli-repeat-entry = Alternate Repeat { $n }：{ $keycode } → { $alt }（{ $state }）
cli-entry-on = 启用
cli-entry-off = 关闭
cli-setting-entry = { $name } = { $value }
cli-device-list = 四个设备槽位：状态、名称、地址；查找期间显示找到的设备
cli-device-scan = 查找可配对的设备 60 秒，并在出现时列出（请让设备进入配对模式）
cli-device-scan-stop = stop 提前停止查找
cli-device-pair = 配对找到的设备：其在列表中的编号或地址
cli-device-forget = 忘记设备的配对：槽位 1-4，或 all
cli-device-log = 显示 KVM 保存的无线模块近期日志：连接、配对、设备为何被断开
cli-device-log-empty = KVM 尚未保存模块日志的任何行。
cli-device-map = 显示 KVM 为槽位 1-4 保存的报告描述符，以及其解析器读出的内容
cli-device-map-none = KVM 没有该槽位的报告描述符（未配对设备，或尚未读取）。
cli-device-map-bytes = 报告描述符，{ $bytes } 字节：
cli-device-map-ok = KVM 可以读取：{ $fields } 个字段。
cli-device-map-incomplete = KVM 只能读取一部分：{ $fields } 个字段；其余超出了它的容量。
cli-device-map-error = KVM 无法读取：{ $error }。
cli-route = follow（当前主机），或固定到一台：pc1、pc2、host1-host4
cli-profile-route = 对设备还可设置其路由：follow、pc1、pc2、host1-host4
cli-ev-devices-changed = { -wireless }设备：查找或配对已更改
cli-ev-device-changed = { -wireless }设备 { $slot } 已更改
cli-pinned = 固定
cli-device-slot = 设备 { $slot }
cli-device-ready = 已连接
cli-battery = 电量 { $percent }%
cli-scan-open = 正在查找设备：剩余 { $seconds } 秒，已找到 { $found } 个
cli-scan-usage = “{ $value }”：请用 `device scan` 或 `device scan stop`
cli-scan-started = 正在查找{ -wireless }设备 { $seconds } 秒：请让设备在 KVM 附近进入配对模式。Ctrl-C 会让 KVM 继续查找。
cli-scan-ended = 已停止查找。用 `odkvmctl device pair <编号>` 配对其中一个。
cli-device-not-found = 未找到设备“{ $which }”：`odkvmctl device scan` 会列出它们
device-passkey = 在键盘上输入 { $passkey }，然后按回车。
make-active = 设为当前
device = 设备
routing = 输入送往
port-module-short = { -wireless }模块
pair-new-device = 配对设备
pair-device-note = 查找键盘和鼠标一分钟。请让设备在 KVM 附近进入配对模式，它会出现在下方。需要密码的键盘会得到六位数字，在其上输入后按回车。
look-for-devices = 查找设备
looking = 正在查找 · { $seconds } 秒
found-none = 尚未找到
device-slots-full = 请先忘记一个设备：四个槽位都已占用
devices = 设备
devices-note = 已配对的设备与前置端口的设备一样属于 KVM：其模式和输入去向在端口页的每个方案中设置。固定的设备总是向其主机输入，不论当前是哪台。
device-away = 不在
device-unsupported = 不支持
battery = 电量 { $percent }%
forget-device-hover = 删除配对。若要重新配对，请让设备进入配对模式。
ev-device-paired = 已配对：{ $device }（{ -wireless }设备 { $slot }）
ev-device-forgot = 已忘记{ -wireless }设备 { $device }

## Erasing every wireless pairing
bt-erase-title = 清除所有配对
bt-erase-note = 忘记无线模块配对过的所有主机和设备及其保存的所有密钥，然后重启模块：用于配对屡次失败，或主机配对后立即断开的情况。同时在主机和设备上删除此 KVM，然后重新配对。
bt-erase-button = 清除所有配对…
bt-erase-really = 所有主机和设备都需要重新配对。
bt-erase-confirm = 清除
cli-wireless-erase = 忘记无线模块配对过的所有主机和设备及其保存的所有密钥，然后重启模块（用于配对屡次失败的情况）
cli-wireless-erased = 模块会忘记所有配对并重启。同时在主机和设备上删除此 KVM，然后重新配对。
cli-hosts-allow = 让{ -wireless }主机通过模块控制 KVM，用 KVM 上的按键确认：从电脑上操作时指定主机的槽位；在主机本身上则不指定
cli-hosts-allow-slot = 主机的槽位（1–4）；不指定：这台通过{ -wireless }连接访问 KVM 的电脑
cli-hosts-disallow = 此槽位的{ -wireless }主机不再能控制 KVM
cli-allow-needs-slot = 这台电脑通过 USB 访问 KVM：请指定{ -wireless }主机的槽位（1–4）
cli-allowed-here = 这台电脑现在可以通过{ -wireless }连接控制 KVM。
cli-host-allowed = { -wireless }主机 { $slot } 现在可以控制 KVM。
host-may-control = 可以控制 KVM
host-controls-now = 其软件已连接
cli-this-computer-host = 这台电脑
cli-list-wireless = { -wireless }
module-adopt-note = 这块 ESP32 板运行着其他固件，所以 KVM 不碰它。它也可以改作{ -wireless }模块。
module-adopt = 把它作为{ -wireless }模块…
module-adopt-really = 它的固件将被{ -wireless }模块的固件替换。
module-adopt-confirm = 替换它的固件
cli-wireless-adopt = 把前面板端口上的 ESP32 板作为{ -wireless }模块，并替换它的固件（用于因运行其他固件而被 KVM 跳过的板子）
cli-wireless-adopt-port = 板子所在的前面板端口：keyboard、mouse 或 other
cli-wireless-adopt-firmware = 取模块固件的版本文件夹（默认：odkvmctl 自带的）
cli-adopting = { $port } 端口上的板子将作为{ -wireless }模块：正在等它进入 ROM…
cli-adopt-busy = 此 KVM 已经有{ -wireless }模块
cli-adopt-empty = { $port } 端口上没有设备
cli-adopt-not-taken = { $port } 端口上的板子没有成为{ -wireless }模块（{ $state }）
