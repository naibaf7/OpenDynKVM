parse-hotkey = Tastenkürzel '{ $value }': { $error } (z. B. double:scrolllock oder ctrl+alt+1)
parse-host-name = Name '{ $value }': höchstens { $max } Bytes (leer: Host n)
parse-profile-name = Name '{ $value }': 1 bis { $max } Bytes
parse-mode = Modus '{ $value }': { $modes }
parse-profile-modes = '{ $value }': sieben Modi, für die Anschlüsse Tastatur, Maus und Weitere und die { -wireless(case: "prefix") }-Geräte 1–4, z. B. auto,auto,passthrough,auto,auto,auto,auto
parse-number = '{ $value }': eine Zahl bis { $max }
parse-one-of = '{ $value }': erlaubt ist { $choices }
parse-keycode = '{ $value }': kein Keycode (eine Taste, ctrl+c, mouse1, pad5, dpad-up, mo(1), lt(1,space), mt(shift,a), none, trans oder eine Zahl)
parse-control = '{ $value }': kein Bedienelement (eine Taste, mouse1–mouse16, pad1–pad32, hat-up oder eine Achsrichtung wie x- oder wheel+)
parse-macro-step = '{ $value }': kein Makroschritt (text:…, tap:<Keycode>, down:<Keycode>, up:<Keycode>, delay:<ms>)
parse-unknown-setting = unbekannte Einstellung

